1 0 0 1 62.69291 58.86614 cm
%PreformattedPara
0 0 0 rg
BT 1 0 0 1 0 480 Tm /F3 7.6 Tf 9.2 TL (#include <stdio.h>) Tj T* (#include <stdlib.h>) Tj T*  T* (typedef struct Node { int key; struct Node *left, *right; } Node;) Tj T*  T* (Node* newNode\(int k\){ Node* n = malloc\(sizeof\(Node\)\); n->key=k; n->left=n->right=NULL; return n; }) Tj T*  T* (Node* insert\(Node* r, int k\){) Tj T* (    if\(!r\) return newNode\(k\);) Tj T* (    if\(k < r->key\) r->left = insert\(r->left, k\);) Tj T* (    else r->right = insert\(r->right, k\);) Tj T* (    return r;) Tj T* (}) Tj T* (void inorder\(Node* r\){ if\(r\){ inorder\(r->left\); printf\("%d ", r->key\); inorder\(r->right\);} }) Tj T* (void preorder\(Node* r\){ if\(r\){ printf\("%d ", r->key\); preorder\(r->left\); preorder\(r->right\);} }) Tj T* (void postorder\(Node* r\){ if\(r\){ postorder\(r->left\); postorder\(r->right\); printf\("%d ", r->key\);} }) Tj T* (int height\(Node* r\){ if\(!r\) return -1; int a=height\(r->left\), b=height\(r->right\); return \(a>b?a:b\)+1; }) Tj T*  T* (int bstSearch\(Node* r, int k, int* cmp\){) Tj T* (    printf\("  Path: "\);) Tj T* (    while\(r\){) Tj T* (        \(*cmp\)++;) Tj T* (        printf\("%d ", r->key\);) Tj T* (        if\(k == r->key\){ printf\("-> FOUND\\n"\); return 1; }) Tj T* (        r = \(k < r->key\) ? r->left : r->right;) Tj T* (    }) Tj T* (    printf\("-> NOT FOUND\\n"\);) Tj T* (    return 0;) Tj T* (}) Tj T* (int linearSearch\(int a[], int n, int k, int* cmp\){) Tj T* (    for\(int i=0;i<n;i++\){ \(*cmp\)++; if\(a[i]==k\) return i; }) Tj T* (    return -1;) Tj T* (}) Tj T*  T* (int main\(void\){) Tj T* (    int keys[] = {45,20,60,10,30,50,70,25,55};) Tj T* (    int n = sizeof\(keys\)/sizeof\(keys[0]\);) Tj T* (    Node* root = NULL;) Tj T* (    for\(int i=0;i<n;i++\) root = insert\(root, keys[i]\);) Tj T*  T* (    printf\("Inorder   : "\); inorder\(root\);   printf\("\\n"\);) Tj T* (    printf\("Preorder  : "\); preorder\(root\);  printf\("\\n"\);) Tj T* (    printf\("Postorder : "\); postorder\(root\); printf\("\\n"\);) Tj T* (    printf\("Height of BST \(edges\) = %d\\n\\n", height\(root\)\);) Tj T*  T* (    int targets[] = {25,55,90};) Tj T* (    int totB=0, totL=0;) Tj T* (    printf\("%-8s %-14s %-14s\\n","Key","BST cmps","Linear cmps"\);) Tj T* (    for\(int i=0;i<3;i++\){) Tj T* (        int cb=0, cl=0;) Tj T* (        printf\("Searching %d \(BST\)\\n", targets[i]\);) Tj T* (        bstSearch\(root, targets[i], &cb\);) Tj T* (        linearSearch\(keys, n, targets[i], &cl\);) Tj T* ET
Q
 

